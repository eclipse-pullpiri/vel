@startuml
title Vehicle Evidence Layer Architecture

package "Evidence Sources" {
  [OS / Middleware]
  [HW Metrics]
  [S-CORE Modules]
}

package "Vehicle Evidence Layer" {
  package "Evidence Ingestion" {
    [Source Collectors]
  }
  package "Evidence Processing" {
    [Schema Validator]
    [Normalization Processor]
    [Quality Evaluator]
    [Traceability Enricher]
  }
  package "Evidence Management" {
    [Evidence Persistence]
  }
  package "Evidence Publication" {
    [Vehicle Evidence Publisher]
    [VEL Health Publisher]
  }
  package "Observability" {
    [Collection and Audit Logging]
  }
}

package "Configuration" {
  [Input Interface Definitions]
  [Output Evidence Definitions]
  [Normalization Mappings]
}

package "External" {
  [Designated Evidence Consumer]
}

[OS / Middleware] --> [Source Collectors] : runtime states
[HW Metrics] --> [Source Collectors] : accessible metrics
[S-CORE Modules] --> [Source Collectors] : module states
[Input Interface Definitions] --> [Source Collectors]
[Source Collectors] --> [Schema Validator] : source records
[Schema Validator] --> [Normalization Processor]
[Normalization Mappings] --> [Normalization Processor]
[Normalization Processor] --> [Quality Evaluator]
[Quality Evaluator] --> [Traceability Enricher]
[Traceability Enricher] --> [Evidence Persistence] : optional persistence
[Traceability Enricher] --> [Vehicle Evidence Publisher] : normalized evidence
[Output Evidence Definitions] --> [Vehicle Evidence Publisher]
[Vehicle Evidence Publisher] --> [Designated Evidence Consumer]
[Traceability Enricher] --> [VEL Health Publisher] : collection status
[Source Collectors] --> [Collection and Audit Logging]
[Schema Validator] --> [Collection and Audit Logging]
[Normalization Processor] --> [Collection and Audit Logging]
[Evidence Persistence] ..> [Vehicle Evidence Publisher] : stored evidence

note right of [Evidence Persistence]
Optional and deployment-configured.
end note

@enduml
